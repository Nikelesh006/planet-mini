    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Sign Up (Local Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('token', data.token);",
                  "        console.log('Saved token to collection variable');",
                  "    }",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set('userId', data.user.id);",
                  "        console.log('Saved userId to collection variable:', data.user.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Register a new local user with email & password. Automatically stores `token` and `userId`."
          }
        },
        {
          "name": "Sign In (Local Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('token', data.token);",
                  "        console.log('Saved token to collection variable');",
                  "    }",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set('userId', data.user.id);",
                  "        console.log('Saved userId to collection variable:', data.user.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
