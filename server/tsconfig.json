{
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", "vite.ts", "static.ts", "**/*.test.ts", "shared/schema.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["node"],
    "noEmit": true
  }
}
