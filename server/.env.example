NODE_ENV=production
PORT=5002

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/planet-mini
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/planet-mini

# App URLs
FRONTEND_URL=https://planet-mini-client.vercel.app
CLIENT_URL=https://planet-mini-client.vercel.app
BACKEND_URL=https://planet-mini-api.vercel.app

# Auth
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
