# Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Connection
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/yourDatabase
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/yourDatabase

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# Server Configuration
NODE_ENV=development
PORT=5002
FRONTEND_URL=http://localhost:5002
CLIENT_URL=http://localhost:5002
BACKEND_URL=http://localhost:5002

# Vite Frontend Configuration
# Use your deployed backend origin for the two-project Vercel setup.
VITE_API_URL=https://planet-mini-api.vercel.app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-number-id
WHATSAPP_ADMIN_PHONE_NUMBER=9597755722
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=new_order_admin_notification





