# Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Connection
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/yourDatabase
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/yourDatabase

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# Server Configuration
NODE_ENV=development
PORT=5002
FRONTEND_URL=http://localhost:5002
CLIENT_URL=http://localhost:5002
BACKEND_URL=http://localhost:5002

# Vite Frontend Configuration
# Use your deployed backend origin for the two-project Vercel setup.
VITE_API_URL=https://planet-mini-api.vercel.app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_API_VERSION=v21.0
ADMIN_WHATSAPP_NUMBER=919597755722
WHATSAPP_ADMIN_TEMPLATE=admin_order_alert
WHATSAPP_CUSTOMER_TEMPLATE=order_confirmation_customer

# Admin Security Configuration
ADMIN_PASSWORD=your_admin_password_or_pin
ADMIN_INITIAL_PIN=your_6_digit_pin
ADMIN_EMAILS=admin@example.com
VITE_ADMIN_EMAILS=admin@example.com

